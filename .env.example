# Скопируйте в .env и заполните ключи. Файл .env не коммитится.
# Платные запросы к Polza AI/OpenRouter разрешены; помечайте прогон [PAID].

# Активный провайдер: polza | openrouter
DECIDE_PROVIDER=polza

# Ключи доступа
POLZA_API_KEY=your_polza_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Базовые URL (можно переопределить на локальный стаб в тестах)
POLZA_BASE_URL=https://polza.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию: gemini | ms | jev | luna
DECIDE_DEFAULT_MODEL=jev

# Хранение и ограничения
DECIDE_DB_PATH=.decide-mcp/runs.sqlite
DECIDE_ALLOWED_ROOT=.
DECIDE_MAX_CONCURRENCY=4
DECIDE_TIMEOUT_MS=30000
